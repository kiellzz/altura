PORT=8080

# Use no mínimo 32 bytes e troque obrigatoriamente fora do ambiente local.
DB_URL=jdbc:postgresql://ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-with-your-neon-password
DB_POOL_MAX_SIZE=5

JWT_SECRET=troque-esta-chave-em-homologacao-e-producao-123456
JWT_ISSUER=altura-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon Object Storage. Use um bucket privado; o backend gera URLs assinadas.
AWS_ENDPOINT_URL_S3=https://SEU-ENDPOINT-DE-STORAGE
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
STORAGE_BUCKET=altura-feed
STORAGE_SIGNED_URL_MINUTES=60

# Altura Intelligence — Gemini API
# Gere sua chave gratuita em: https://aistudio.google.com/apikey
# Sem esta chave o endpoint /api/intelligence/analyze retornará 503.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
